# Copy to .env and fill in your Alpaca PAPER keys (https://app.alpaca.markets -> Paper account -> API Keys)
ALPACA_API_KEY=your_key_id_here
ALPACA_SECRET_KEY=your_secret_here

# Paper trading base (leave as-is for paper). Live would be https://api.alpaca.markets
ALPACA_PAPER_BASE=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets

# Data feed: "sip" (all exchanges, needs a data subscription) or "iex" (free tier).
# Your account used sip successfully; if you get 403s on bars, switch to iex.
ALPACA_FEED=sip

# Backend port
PORT=3001

# ---- Flow conviction (auto-trader) ---------------------------------------
# Directory holding the OptionStrat master workbooks (flow_master.xlsx etc.).
# Defaults to the project root if unset. Overridden by flow.optionstratDir in
# server/autotrader.config.json when that is set.
OPTIONSTRAT_DIR=

# Unusual Whales live-flow source (optional; leave blank to keep it OFF).
UW_API_KEY=
# Advanced overrides — usually leave default:
# UW_API_BASE=https://api.unusualwhales.com
# UW_FLOW_PATH=/api/stock/{ticker}/flow-alerts
# UW_LOOKBACK_MIN=240
